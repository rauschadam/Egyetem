# Egyelőre csak a weboldal és a DIMAT II / ANAL II / Prog Elmélet / ALGO II / C++ / EVA tárgy kerül a repóba.
# Minden mást kizárunk; új tárgyat egy újabb "!/<mappa>/" sorral lehet felvenni.
/*
!/.gitignore
!/index.html
!/DIMAT II/
!/ANAL II/
!/Prog Elmélet/
!/ALGO II/
!/C++/
!/EVA/
# ALGO II-ből egyelőre csak a gyakorlat (az előadásdiák nagyok, még nincsenek feldolgozva)
/ALGO II/Előadás/
# A plusz pontos (szorgalmi) beadandók nem kerülnek a repóba
/ALGO II/Plusz pont feladatok/
/DIMAT II/Beadandok/
# A gyakorlati táblaképek nyers .enb fájljai (tollvonások) nem kellenek a weboldalhoz
/DIMAT II/Gyakorlat táblaképek/
# C++-ból csak az előadásdiák és a kidolgozások; a saját gyakorlati kódok nem
/C++/*Gyak*/
# EVA-ból csak az anyagok és a kidolgozások; a beadandó (külön repó), a tanszéki mintakód és a saját gyakorlati kódok nem
/EVA/Beadandó/
/EVA/Beadandó példa/
/EVA/Gyak[0-9]*/
# A saját minta ZH-megoldásaim sem
/EVA/Minta ZH/

# Build-szemét
bin/
obj/
.vs/
TestResults/
*.exe
*.dll
*.pdb

# Archívumok
*.zip
